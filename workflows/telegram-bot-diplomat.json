    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-4o-mini"
        },
        "responses": {
          "values": [
            {
              "role": "system",
              "content": "Ты — первоклассный дипломат, медиатор и эксперт по жестким бизнес-коммуникациям.\n\nК тебе поступает сырой текст: расшифровка голосового сообщения, где пользователь эмоционально, резко, саркастично или грубо выражает недовольство коллеге, клиенту, подрядчику или исполнителю.\n\nТвоя задача:\n1. Вычленить суть претензии и ключевые требования пользователя.\n2. Перевести сообщение на безупречный деловой язык.\n3. Сохранить смысл и твердость позиции автора.\n4. Сделать текст вежливым, профессиональным, уважительным, но уверенным.\n5. Избегать заискивания, пассивной агрессии и канцелярского мусора.\n\nВыдай только готовый текст сообщения для отправки адресату. Без вступлений, объяснений и комментариев."
            },
            {
              "content": "={{ \"Расшифровка эмоционального сообщения:\\n\" + $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {
          "maxTokens": 1200,
          "store": false,
          "textFormat": {
            "textOptions": {}
          },
          "temperature": 0.2
        }
      },
      "name": "OpenAI - GPT-4o-mini Diplomat",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        1968,
        -240
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const message = $json.output?.find?.((item) => item.type === 'message') || $json.output?.[0];\nconst raw = String(message?.content?.find?.((part) => part.type === 'output_text')?.text || message?.content?.[0]?.text || $json.text || '').trim();\nfunction escapeHtml(value) {\n  return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n}\nconst clean = raw.replace(/^\\s*```[a-z]*\\s*/i, '').replace(/\\s*```\\s*$/i, '').trim();\nconst telegram_text = [\n  '✨ <b>Твое сообщение переведено на дипломатический язык:</b>',\n  '',\n  '<pre>' + escapeHtml(clean) + '</pre>',\n  '',\n  '<i>Нажми на текст выше, чтобы скопировать его и отправить адресату.</i>'\n].join('\\n');\nreturn [{ json: { raw_text: clean, telegram_text } }];"
      },
      "name": "Code - Prepare Telegram HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2208,
        -240
      ]
    },
