        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  records: [\n    {\n      fields: {\n        telegram_id: String($node['Telegram Trigger'].json.message.from.id),\n        chat_id: String($node['Telegram Trigger'].json.message.chat.id),\n        username: $node['Telegram Trigger'].json.message.from.username || '',\n        first_name: $node['Telegram Trigger'].json.message.from.first_name || '',\n        daily_requests: 0,\n        status: 'free',\n        created_at: new Date().toISOString(),\n        updated_at: new Date().toISOString()\n      }\n    }\n  ],\n  typecast: true\n}) }}",
