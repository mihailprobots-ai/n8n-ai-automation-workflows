    {
      "parameters": {
        "jsCode": "const found = $('Airtable - Find User').first().json.records?.[0];\nlet created;\ntry {\n  created = $('Airtable - Create User').first().json.records?.[0];\n} catch (error) {\n  created = null;\n}\nconst message = $('Telegram Trigger').first().json.message || {};\nconst audio = message.voice || message.audio || {};\nconst record = found || created || null;\nconst fields = record?.fields || {};\nconst dailyRequests = Number(fields.daily_requests || 0);\nconst status = fields.status || 'free';\nreturn [\n  {\n    json: {\n      record_id: record?.id || '',\n      telegram_id: String(message.from?.id || ''),\n      chat_id: String(message.chat?.id || ''),\n      file_id: audio.file_id,\n      file_size: Number(audio.file_size || 0),\n      duration: Number(audio.duration || 0),\n      daily_requests: dailyRequests,\n      status,\n      request_log: String(fields.request_log || ''),\n      limit_exceeded: status === 'free' && dailyRequests >= 10\n    }\n  }\n];"
      },
