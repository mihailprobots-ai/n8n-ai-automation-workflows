      "parameters": {
        "method": "PATCH",
        "url": "https://api.airtable.com/v0/app8WwldFfIvAAmPU/tblV9UHY60S2KB0aV",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
