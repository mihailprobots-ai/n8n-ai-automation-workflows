        "jsonBody": "={{ JSON.stringify({\n  records: [\n    {\n      id: $node['Code - Normalize Airtable User'].json.record_id,\n      fields: {\n        daily_requests: Number($node['Code - Normalize Airtable User'].json.daily_requests || 0) + 1,\n        updated_at: new Date().toISOString(),\n        last_request_at: new Date().toISOString(),\n        last_raw_text: $node['Code - Validate Transcription'].json.text,\n        last_result: $node['Code - Prepare Telegram HTML'].json.raw_text,\n        request_log: (() => {\n          const oldLog = String($node['Code - Normalize Airtable User'].json.request_log || '');\n          const raw = String($node['Code - Validate Transcription'].json.text || '').slice(0, 4000);\n          const result = String($node['Code - Prepare Telegram HTML'].json.raw_text || '').slice(0, 6000);\n          const entry = '[' + new Date().toISOString() + ']\\nRAW: ' + raw + '\\nRESULT: ' + result + '\\n---\\n';\n          return (entry + oldLog).slice(0, 95000);\n        })()\n      }\n    }\n  ],\n  typecast: true\n}) }}",
        "options": {}
